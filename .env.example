# Nostralytics Configuration

# Your Nostr Private Key (Hex or nsec)
# All published signals will be signed with this identity
NOSTR_PRIVATE_KEY=your_private_key_here

# Comma-separated list of relays
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social

# Blockchain RPC URLs
# Adapters will only start if the corresponding URL/Key is provided

# EVM (Ethereum, Base, etc.)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# TRON
TRON_API_KEY=your_tron_grid_key

# Cosmos
COSMOS_RPC_URL=https://rpc.cosmos.network:443

# Bitcoin (Optional, defaults to public explorers if not provided)
BTC_RPC_URL=

# Move (Aptos / Sui)
APTOS_RPC_URL=
SUI_RPC_URL=
